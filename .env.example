APP_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=chordbase
POSTGRES_USER=chordbase
POSTGRES_PASSWORD=chordbase
JWT_SECRET=change-me-only-for-local-development
JWT_ISSUER=chordbase-api
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_TIME_ZONE=America/Sao_Paulo
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_PATH=/users
CORS_EXTRA_ALLOWED_ORIGIN=
MAX_UPLOAD_SIZE=30MB
JAVA_MEMORY_OPTS=-Xms64m -Xmx192m -XX:+ExitOnOutOfMemoryError
OCR_MAX_PIXELS=4000000
OCR_MAX_EDGE=2400
OCR_MAX_SOURCE_PIXELS=16000000
OCR_MAX_CONCURRENT_JOBS=1
OCR_MAX_PENDING_JOBS=2
OCR_ADMISSION_TIMEOUT_SECONDS=0.1
OCR_QUEUE_TIMEOUT_SECONDS=10
OCR_RETRY_AFTER_SECONDS=2
PDF_MAX_RENDERED_PIXELS_PER_PAGE=16000000
PDF_MAX_RENDERED_PIXELS_DOCUMENT=40000000
TEXT_MAX_TOKENS=100000
MAX_CHORDPRO_OUTPUT_BYTES=2000000
